<% layout("/layouts/boilerplate") -%>

<div class="container mt-4">
    <h2 class="mb-4 text-center">My Bookings</h2>

    <% if (bookings.length === 0) { %>
        <p class="text-center text-muted">You have no bookings yet.</p>

    <% } else { %>

        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Sport Item</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% for (let b of bookings) { %>

                    <% 
                        const itemExists = !!b.sportItem;

                        const now = new Date();
                        const start = new Date(b.startAt);
                        const end = new Date(b.endAt);

                        // -------- STATUS LOGIC --------
                        let displayStatus = b.status;

                        if (b.status !== "cancelled" && b.status !== "completed") {
                            if (start <= now && now <= end) {
                                displayStatus = "ongoing";
                            } else if (start > now) {
                                displayStatus = "upcoming";
                            } else if (end < now) {
                                displayStatus = "completed";
                            }
                        }

                        // Action availability
                        const isCancellable = itemExists && displayStatus === "upcoming";
                    %>

                    <tr class="<%= (b.status === 'cancelled') ? 'table-danger' : (isCancellable ? '' : 'table-warning') %>">

                        <td>
                            <% if (itemExists) { %>
                                <a href="/sportItems/<%= b.sportItem._id %>">
                                    <%= b.sportItem.title %>
                                </a>
                            <% } else { %>
                                **Item Deleted**
                            <% } %>
                        </td>

                        <td><%= b.startAt.toLocaleString() %></td>
                        <td><%= b.endAt.toLocaleString() %></td>

                        <!-- NEW DISPLAYED STATUS -->
                        <td><%= displayStatus %></td>

                        <td>
                            <% if (isCancellable) { %>
                                <form method="POST" action="/<%= b._id %>/cancel?_method=PUT">
                                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                </form>

                            <% } else if (displayStatus === "cancelled") { %>
                                <span class="text-danger">N/A</span>

                            <% } else { %>
                                <span class="text-muted">No Action</span>
                            <% } %>
                        </td>

                    </tr>

                <% } %>
            </tbody>

        </table>
    <% } %>
</div>
